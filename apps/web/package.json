{
  "name": "vsign-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "VITE_PUBLIC_DEMO=true VITE_BASE_PATH=/VSign/ npm run build",
    "build:public:root": "VITE_PUBLIC_DEMO=true VITE_BASE_PATH=/ npm run build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-mage-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@vitejs/plugin-react": "4.4.1",
    "onnxruntime-web": "1.29.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-is": "19.1.0",
    "recharts": "3.10.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@iconify-json/mage": "1.2.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.21",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.1.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vitest": "5.0.0"
  }
}
