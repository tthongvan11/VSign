INFERENCE_BACKEND=onnx
MODEL_VERSION=sales30-mvitv2s-seated-v3-epoch5
ONNX_MODEL_PATH=ml/artifacts/sales30_seated_v3/model.onnx
PYTORCH_MODEL_PATH=
PYTORCH_DEVICE=auto
LABEL_MAP_PATH=ml/artifacts/sales30_seated_v3/labels.json
# Optional immutable runtime contract for the active model.
MODEL_MANIFEST_PATH=
LABELS_VERIFIED=true
CONFIDENCE_THRESHOLD=0.70
MARGIN_THRESHOLD=0.15
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:8080
MAX_FRAME_BYTES=262144
MAX_MESSAGE_BYTES=6291456
COLLECTION_ENABLED=false
COLLECTION_DIR=ml/data/collected/sales30
COLLECTION_TARGET_PER_HAND=50
OPENAI_API_KEY=
OPENAI_MODEL=
SENTENCE_RULES=expanded
APP_ENV=production
WORKSPACE_ID=local
WORKSPACE_NAME=VSign workspace
DATABASE_URL=sqlite:///./data/vsign-platform.db
DATABASE_AUTO_CREATE=false
AUTH_REQUIRED=false
# Empty: auto-enable enterprise admin in development when AUTH_REQUIRED=false.
# Enterprise admin cannot register, approve, deploy or roll back models.
# Set false to use sessions; never enable on a public deployment.
LOCAL_ADMIN_ENABLED=
# Explicit local system console; admin remains the enterprise-compatible default.
# Prefer scripts/run_system_admin_local.sh, which enforces loopback binding.
LOCAL_ADMIN_ROLE=admin
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=28800
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace Admin
POSTGRES_DB=vsign
POSTGRES_USER=vsign
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DEV_TEST_ENABLED=false
DEV_TEST_DIR=ml/data/dev-tests/manual
# Local registry: enable the worker only on the recognition runtime, never on platform.
MODEL_REGISTRY_ROOTS=ml/artifacts
MODEL_EVALUATION_ROOTS=ml/evaluations
# Operator-owned Fernet key; never store the value in the database or Git.
# Leave both empty to keep webhook creation unavailable.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_FILE=
MODEL_DEPLOYMENT_WORKER=false
MODEL_DEPLOYMENT_TARGET=production-local
MODEL_DEPLOYMENT_RUNTIME_URL=http://127.0.0.1:8002
# Non-file databases require absolute protected training roots, separated by ':' on macOS/Linux.
# MODEL_PROTECTED_ARTIFACT_ROOTS=/absolute/immutable/models
VITE_INFERENCE_WS_URL=ws://localhost:8000/ws/inference
VITE_INFERENCE_HTTP_URL=http://localhost:8000
VITE_PLATFORM_HTTP_URL=http://localhost:8000
VITE_PLATFORM_AUTH_REQUIRED=false
# Optional Modal recognition runtime; configure both to enable automatic GPU/Mac selection.
# See docs/MODAL_GPU.md for deployed URLs and the shared token secret setup.
VITE_INFERENCE_MODAL_HTTP_URL=
VITE_INFERENCE_MODAL_WS_URL=
# Optional candidate endpoint for the local development model selector.
VITE_SEATED_INFERENCE_WS_URL=ws://localhost:8003/ws/inference
VITE_SEATED_INFERENCE_HTTP_URL=http://localhost:8003
